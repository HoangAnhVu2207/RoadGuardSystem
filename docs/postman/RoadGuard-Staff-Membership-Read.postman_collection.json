  "item": [
    {
      "name": "Nhân sự và phân công",
      "description": "Chọn environment → login H00 Supervisor/PM → 01 chọn dự án → 02/03 lấy userId → 05/08 lấy membershipVersion. projectSearch/staffSearch tùy chọn, không body GET. 03 tự chọn PM khác currentPrimaryPmUserId nếu đã chạy 08. Nếu danh sách nhiều kết quả, thu hẹp search rồi chạy lại. Không đổi actorUserId/targetUserId. Cookie: dùng web csrf/login hiện có trên cùng HTTPS origin, bật cookie jar; không Authorization. Folder này chỉ GET; chạy cả folder không đổi PM. PUT có trong collection riêng CHỈ chạy khi chủ động chọn. Import lại collection sau cập nhật; Postman không tự reload file.",
      "item": [
        {
          "name": "01 — Chọn dự án (Supervisor)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/projects?search={{projectSearch}}"
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "if (pm.response.code === 200) { const p=pm.response.json(); pm.test('Project page',()=>pm.expect(p.items).to.be.an('array'));",
                  "if (p.items.length === 1) pm.environment.set('projectId',p.items[0].projectId);",
                  "else if (!pm.environment.get('projectId') && p.items.length) pm.environment.set('projectId',p.items[0].projectId); }"
                ]
              }
            }
          ]
        },
