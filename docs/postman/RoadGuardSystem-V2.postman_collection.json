{
  "info": {
    "_postman_id": "8f2ef1e9-6f14-4d4b-8c7d-7c2a4f5d1a20",
    "name": "RoadGuardSystem V2 API",
    "description": "RoadGuard V2 API smoke and manual test collection. Select the RoadGuard.local environment and set its local values before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "profileRowVersion", "value": "", "type": "string" },
    { "key": "targetUserId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "targetRowVersion", "value": "", "type": "string" },
    { "key": "projectId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "projectRowVersion", "value": "", "type": "string" },
    { "key": "primaryProjectManagerUserId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "registrationIntentId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "invitationId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" },
    { "key": "invitationVersion", "value": "", "type": "string" },
    { "key": "actorVersion", "value": "", "type": "string" },
    { "key": "reporterRegistrationKey", "value": "reporter-registration-runner", "type": "string" },
    { "key": "reporterVerificationKey", "value": "reporter-verification-runner", "type": "string" },
    { "key": "reporterResendKey", "value": "reporter-resend-runner", "type": "string" },
    { "key": "invitationCreateKey", "value": "invitation-create-runner", "type": "string" },
    { "key": "invitationAcceptKey", "value": "invitation-accept-runner", "type": "string" },
    { "key": "updateMeKey", "value": "update-me-runner", "type": "string" },
    { "key": "updateAccountKey", "value": "update-account-runner", "type": "string" },
    { "key": "passwordResetKey", "value": "password-reset-runner", "type": "string" }
    ,{ "key": "inspectionCursor", "value": "", "type": "string" }
    ,{ "key": "inspectionLimit", "value": "50", "type": "string" }
    ,{ "key": "roadSectionId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" }
    ,{ "key": "roadSectionVersionId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" }
    ,{ "key": "surveyPlanId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" }
    ,{ "key": "surveyRequestId", "value": "00000000-0000-0000-0000-000000000000", "type": "string" }
    ,{ "key": "surveyPlanCreateKey", "value": "survey-plan-runner", "type": "string" }
    ,{ "key": "surveyRequestCreateKey", "value": "survey-request-runner", "type": "string" }
    ,{ "key": "surveyPostponeKey", "value": "survey-postpone-runner", "type": "string" }
  ],
  "item": [
    {
      "name": "Survey planning (ordered)",
      "item": [
        {
          "name": "POST /projects/{projectId}/road-sections/{roadSectionId}/survey-plans - success",
          "request": {
            "description": "Purpose: create a survey plan. Role: Project Manager with effective project scope. Setup: set projectId, roadSectionId and roadSectionVersionId from permitted fixtures; use a fresh Idempotency-Key. Expected: 201 plan and Location. Data change: plan, audit and idempotency receipt.",
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Idempotency-Key", "value": "{{surveyPlanCreateKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"plannedStartAt\": \"2026-10-01T08:00:00Z\",\n  \"plannedEndAt\": \"2026-10-01T10:00:00Z\",\n  \"roadSectionVersionId\": \"{{roadSectionVersionId}}\",\n  \"surveyType\": 2,\n  \"outputRequirements\": \"{\\\"formats\\\":[\\\"video\\\",\\\"srt\\\"]}\",\n  \"operationId\": \"{{$guid}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/road-sections/{{roadSectionId}}/survey-plans", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects", "{{projectId}}", "road-sections", "{{roadSectionId}}", "survey-plans"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Survey plan create returns 201', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) pm.collectionVariables.set('surveyPlanId', pm.response.json().planId);"] } }]
        },
        {
          "name": "POST /projects/{projectId}/road-sections/{roadSectionId}/survey-requests - success",
          "request": {
            "description": "Purpose: create a survey request from the plan. Role: Project Manager with effective project scope. Setup: run plan create first. Expected: 201 request. Data change: request, audit and idempotency receipt.",
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Idempotency-Key", "value": "{{surveyRequestCreateKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"surveyPlanId\": \"{{surveyPlanId}}\",\n  \"roadSectionVersionId\": \"{{roadSectionVersionId}}\",\n  \"surveyType\": 2,\n  \"dueAt\": \"2026-10-04T17:00:00Z\",\n  \"outputRequirements\": \"{\\\"formats\\\":[\\\"video\\\",\\\"srt\\\"]}\",\n  \"operationId\": \"{{$guid}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/road-sections/{{roadSectionId}}/survey-requests", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects", "{{projectId}}", "road-sections", "{{roadSectionId}}", "survey-requests"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Survey request create returns 201', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) pm.collectionVariables.set('surveyRequestId', pm.response.json().requestId);"] } }]
        },
        {
          "name": "POST /projects/{projectId}/survey-plans/{surveyPlanId}/postpone - success",
          "request": {
            "description": "Purpose: postpone an existing plan and append its reason. Role: Project Manager with effective project scope. Setup: run plan create first; use a fresh Idempotency-Key. Expected: 200 postponement. Data change: plan status/date, append-only postponement, audit and idempotency receipt.",
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Idempotency-Key", "value": "{{surveyPostponeKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"newPlannedStartAt\": \"2026-10-02T08:00:00Z\",\n  \"reason\": \"Weather delay\",\n  \"operationId\": \"{{$guid}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/survey-plans/{{surveyPlanId}}/postpone", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects", "{{projectId}}", "survey-plans", "{{surveyPlanId}}", "postpone"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Survey postpone returns 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "POST /projects/{projectId}/road-sections/{roadSectionId}/survey-plans - unauthorized",
          "request": {
            "description": "Purpose: verify bearer authentication is required. Role: none. Setup: no token. Expected: 401. Data change: none.",
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/road-sections/{{roadSectionId}}/survey-plans", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects", "{{projectId}}", "road-sections", "{{roadSectionId}}", "survey-plans"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unauthorized survey plan returns 401', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "POST /projects/{projectId}/road-sections/{roadSectionId}/survey-plans - idempotency conflict",
          "request": {
            "description": "Purpose: verify same idempotency key with changed payload is rejected. Role: Project Manager. Setup: run the success request first, then change the date while reusing surveyPlanCreateKey. Expected: 409 duplicate/idempotency conflict. Data change: none on conflict.",
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Idempotency-Key", "value": "{{surveyPlanCreateKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"plannedStartAt\": \"2026-11-01T08:00:00Z\",\n  \"plannedEndAt\": \"2026-11-01T10:00:00Z\",\n  \"roadSectionVersionId\": \"{{roadSectionVersionId}}\",\n  \"surveyType\": 2,\n  \"outputRequirements\": \"{\\\"formats\\\":[\\\"video\\\"]}\",\n  \"operationId\": \"{{$guid}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/road-sections/{{roadSectionId}}/survey-plans", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects", "{{projectId}}", "road-sections", "{{roadSectionId}}", "survey-plans"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Changed idempotency payload returns 409', function () { pm.expect([409, 422]).to.include(pm.response.code); });"] } }]
        }
      ]
    },
    {
      "name": "Inspection tasks",
      "item": [
        {
          "name": "GET /me/inspection-tasks - success",
          "request": {
            "description": "Purpose: list inspection tasks actively assigned to the current repair crew. Role: Repair Crew with effective project membership. Setup: login as the seeded crew account and set accessToken; optionally set inspectionCursor from a prior response. Expected: 200 InspectionTaskPage. Data change: none.",
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me/inspection-tasks?limit={{inspectionLimit}}&cursor={{inspectionCursor}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me", "inspection-tasks"], "query": [{ "key": "limit", "value": "{{inspectionLimit}}" }, { "key": "cursor", "value": "{{inspectionCursor}}", "disabled": true }] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Inspection task list returns 200', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) { var b = pm.response.json(); pm.expect(b).to.have.property('items'); pm.expect(b).to.have.property('asOf'); if (b.nextCursor) pm.collectionVariables.set('inspectionCursor', b.nextCursor); }"] } }]
        },
        {
          "name": "GET /me/inspection-tasks - unauthorized",
          "request": {
            "description": "Purpose: verify bearer authentication is required. Role: none. Setup: none. Expected: 401 ProblemDetails. Data change: none.",
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me/inspection-tasks?limit={{inspectionLimit}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me", "inspection-tasks"], "query": [{ "key": "limit", "value": "{{inspectionLimit}}" }] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unauthenticated inspection task list returns 401', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "GET /me/inspection-tasks - wrong role",
          "request": {
            "description": "Purpose: verify role policy rejects a non-crew actor. Role: Project Manager/operator. Setup: set accessToken to a non-crew seeded token. Expected: 403 ProblemDetails. Data change: none.",
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me/inspection-tasks?limit={{inspectionLimit}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me", "inspection-tasks"], "query": [{ "key": "limit", "value": "{{inspectionLimit}}" }] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Wrong role inspection task list returns 403', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "GET /me/inspection-tasks - invalid cursor",
          "request": {
            "description": "Purpose: verify cursor validation. Role: Repair Crew. Setup: login as seeded crew; no data mutation. Expected: 400 validation ProblemDetails. Data change: none.",
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/me/inspection-tasks?cursor=invalid&limit={{inspectionLimit}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "me", "inspection-tasks"], "query": [{ "key": "cursor", "value": "invalid" }, { "key": "limit", "value": "{{inspectionLimit}}" }] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid cursor returns 400', function () { pm.response.to.have.status(400); });"] } }]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "description": "Purpose: confirm the API is reachable. Role: none. Setup: select RoadGuard.local and set baseUrl. Expected: 200 (or 204). Data change: none.",
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Health is available', function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"] } }]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /auth/login - valid",
          "request": {
            "description": "Purpose: authenticate the selected seeded account. Role: any seeded role. Setup: set authEmail/authPassword in the environment. Expected: 200 with accessToken, refreshToken and user. Errors: 400/401 for invalid input. Data change: creates a session.",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login returns 200', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) { var b = pm.response.json(); pm.collectionVariables.set('accessToken', b.accessToken); pm.collectionVariables.set('refreshToken', b.refreshToken); pm.collectionVariables.set('profileRowVersion', b.user.rowVersion); pm.collectionVariables.set('targetUserId', b.user.id); }"] } }]
        },
        {
          "name": "POST /auth/login - invalid credentials",
          "request": {
            "description": "Purpose: verify credential rejection. Role: none. Setup: API reachable. Expected: 401 and stable auth error without tokens. Data change: none.",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"invalid-password\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid login returns 401', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "description": "Purpose: rotate/refresh the active session. Role: authenticated session. Setup: run valid login first. Expected: 200 with replacement tokens. Errors: 401 for expired/revoked refresh token. Data change: session state may rotate.",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Refresh returns 200', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) { var b = pm.response.json(); pm.collectionVariables.set('accessToken', b.accessToken); pm.collectionVariables.set('refreshToken', b.refreshToken); }"] } }]
        },
        {
          "name": "POST /auth/password-recovery-requests",
          "request": {
            "description": "Purpose: request password recovery. Role: unauthenticated caller. Setup: set a permitted email. Expected: 202 without credential disclosure. Data change: creates a recovery request.",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{authEmail}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/password-recovery-requests", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "password-recovery-requests"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Recovery returns 202', function () { pm.response.to.have.status(202); });", "pm.test('No credential disclosure', function () { pm.expect(pm.response.text()).to.not.match(/passwordHash|temporaryPassword/i); });"] } }]
        },
        {
          "name": "POST /auth/change-password - destructive",
          "request": {
            "description": "Purpose: change the current user's password. Role: authenticated user. Setup: run login; set replacementPassword; use a disposable account and fresh Idempotency-Key. Expected: 204. Errors: 400/401/409 per contract. Data change: destructive credential/session change.",
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{authPassword}}\",\n  \"newPassword\": \"{{replacementPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "change-password"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Password change returns 204', function () { pm.response.to.have.status(204); });"] } }]
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "description": "Purpose: revoke the active session. Role: authenticated user. Setup: run login first; use a fresh Idempotency-Key. Expected: 204. Data change: session revocation.",
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Logout returns 204', function () { pm.response.to.have.status(204); });"] } }]
        }
      ]
    },
    {
      "name": "Reporter onboarding (ordered)",
      "item": [
        {
          "name": "POST /auth/reporter-registrations - success",
          "request": {
            "description": "Purpose: create a pending Reporter registration and send OTP. Role: public. Setup: configure IdentityOnboarding secret/message provider and set reporterEmail/reporterPassword. Expected: 202 RegistrationIntent and Location. Data change: pending user, OTP hash and idempotency receipt.",
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{reporterRegistrationKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{reporterEmail}}\",\n  \"password\": \"{{reporterPassword}}\",\n  \"displayName\": \"Postman Reporter\",\n  \"reporterType\": \"CITIZEN\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reporter-registrations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reporter-registrations"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registration returns 202', function () { pm.response.to.have.status(202); });", "pm.test('Registration response is safe', function () { pm.expect(pm.response.text()).to.not.match(/password|otp/i); });", "if (pm.response.code === 202) pm.collectionVariables.set('registrationIntentId', pm.response.json().intentId);"] } }]
        },
        {
          "name": "POST /auth/reporter-registrations - validation",
          "request": {
            "description": "Purpose: reject non-Gmail Reporter registration. Role: public. Setup: none. Expected: 400 validation response and no durable user. Data change: none.",
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"invalid@example.test\",\n  \"password\": \"{{reporterPassword}}\",\n  \"displayName\": \"Invalid Reporter\",\n  \"reporterType\": \"CITIZEN\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reporter-registrations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reporter-registrations"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid Reporter registration returns 400', function () { pm.response.to.have.status(400); });"] } }]
        },
        {
          "name": "POST /auth/reporter-registrations/verify - success",
          "request": {
            "description": "Purpose: consume the mailbox OTP once and issue Reporter tokens. Role: public intent holder. Setup: run registration, copy OTP from the configured mailbox into reporterOtp. Expected: 200 TokenPair. Data change: activates account and creates one session.",
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{reporterVerificationKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"intentId\": \"{{registrationIntentId}}\",\n  \"otp\": \"{{reporterOtp}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reporter-registrations/verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reporter-registrations", "verify"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OTP verification returns 200', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) { var b = pm.response.json(); pm.collectionVariables.set('accessToken', b.accessToken); pm.collectionVariables.set('refreshToken', b.refreshToken); }"] } }]
        },
        {
          "name": "POST /auth/reporter-registrations/verify - invalid OTP",
          "request": {
            "description": "Purpose: reject an invalid OTP without issuing credentials. Role: public intent holder. Setup: use a pending registrationIntentId. Expected: 400/404/429 without tokens. Data change: failed-attempt counter only.",
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{$guid}}" }, { "key": "Content-Type", "value": "application/json" }],
