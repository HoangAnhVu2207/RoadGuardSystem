        {
          "name": "03 — Chọn PM ACTIVE theo tên/email",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supervisorToken}}",
                  "type": "string"
