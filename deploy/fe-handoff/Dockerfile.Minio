# MinIO images are not assumed public. Build the pinned upstream release from source.
FROM golang:1.24.6-alpine AS build
RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 --branch RELEASE.2025-09-07T16-13-09Z https://github.com/minio/minio.git . && test "$(git rev-parse HEAD)" = "07c3a429bfed433e49018cb0f78a52145d4bedeb"
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=768MiB
RUN go build -p 2 -trimpath -o /minio .
FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /minio /usr/bin/minio
ENTRYPOINT ["/usr/bin/minio"]
