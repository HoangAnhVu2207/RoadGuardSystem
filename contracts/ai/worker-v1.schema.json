{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roadguard:private:worker-v1",
  "title": "Private rg-ai-worker-v1",
  "oneOf": [
    {
      "$ref": "#/$defs/admission"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "admission": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "jobId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "datasetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "sourceVideoFileId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "modelVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpointSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preprocessingVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "configVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "contractVersion": {
          "const": "rg-ai-worker-v1"
        },
        "sampleFps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "inputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "inputDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "inputWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "inputHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "maxFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "projectId",
        "jobId",
        "attemptId",
        "datasetId",
        "sourceVideoFileId",
        "modelVersionId",
        "manifestHash",
        "checkpointSha256",
        "inputSha256",
        "preprocessingVersion",
        "configVersion",
        "contractVersion",
        "sampleFps",
        "inputBytes",
        "inputDurationMs",
        "inputWidth",
        "inputHeight",
        "maxFrames"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "jobId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "datasetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "sourceVideoFileId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "modelVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpointSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preprocessingVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "configVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "contractVersion": {
          "const": "rg-ai-worker-v1"
        },
        "sampleFps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "inputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "inputDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "inputWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "inputHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "maxFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "resultId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "rawArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "mediaType": {
              "const": "application/json"
            }
          },
          "required": [
            "artifactId",
            "sha256",
            "bytes",
            "mediaType"
          ],
          "additionalProperties": false
        },
        "frameArtifacts": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "mediaType": {
                "const": "image/jpeg"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              }
            },
            "required": [
              "artifactId",
              "sha256",
              "bytes",
              "mediaType",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "detections": {
          "type": "array",
          "maxItems": 10000000,
          "items": {
            "type": "object",
            "properties": {
              "detectionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "frameArtifactId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "timestampMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "sourceClass": {
                "enum": [
                  "alligator crack",
                  "longitudinal crack",
                  "oblique crack",
                  "pothole",
                  "repair",
                  "transverse crack"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "required": [
              "detectionId",
              "frameArtifactId",
              "timestampMs",
              "sourceClass",
              "confidence",
              "bbox"
            ],
            "additionalProperties": false
          }
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "EMBEDDED",
                "PAIRED_SRT",
                "NONE"
              ]
            },
            "outcome": {
              "enum": [
                "EXTRACTED_VALID",
                "NO_SUBTITLE_STREAM",
                "UNSUPPORTED_STREAM",
                "INVALID_TELEMETRY",
                "TELEMETRY_AMBIGUOUS",
                "EXTRACTION_FAILED"
              ]
            },
            "sourceVideoSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "streamIndex": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 2147483647
            },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "srtArtifact": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                      "not": {
                        "const": "00000000-0000-0000-0000-000000000000"
                      }
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16777216
                    },
                    "mediaType": {
                      "const": "application/x-subrip"
                    }
                  },
                  "required": [
                    "artifactId",
                    "sha256",
                    "bytes",
                    "mediaType"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "source",
            "outcome",
            "sourceVideoSha256",
            "streamIndex",
            "extractorVersion",
            "srtArtifact"
          ],
          "additionalProperties": false
        },
        "roadMaskStatus": {
          "enum": [
            "AVAILABLE",
            "NOT_AVAILABLE"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          }
        }
      },
      "required": [
        "projectId",
        "jobId",
        "attemptId",
        "datasetId",
        "sourceVideoFileId",
        "modelVersionId",
        "manifestHash",
        "checkpointSha256",
        "inputSha256",
        "preprocessingVersion",
        "configVersion",
        "contractVersion",
        "sampleFps",
        "inputBytes",
        "inputDurationMs",
        "inputWidth",
        "inputHeight",
        "maxFrames",
        "resultId",
        "rawArtifact",
        "frameArtifacts",
        "detections",
        "telemetry",
        "roadMaskStatus",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
